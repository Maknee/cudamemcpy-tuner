cmake_minimum_required(VERSION 3.24)

# Build-generated headers use this same file in script mode.
if(CMT_SCRIPT STREQUAL "build_info")
  set(_commit "none")
  set(_dirty -1)
  find_program(_git git)
  if(_git)
    execute_process(COMMAND ${_git} -C ${REPO} rev-parse --show-toplevel RESULT_VARIABLE _rc OUTPUT_VARIABLE _top
      ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    get_filename_component(_repo_real ${REPO} REALPATH)
    if(_rc EQUAL 0)
      get_filename_component(_top ${_top} REALPATH)
    endif()
    if(_rc EQUAL 0 AND _top STREQUAL _repo_real)
      execute_process(COMMAND ${_git} -C ${REPO} rev-parse --verify --quiet HEAD RESULT_VARIABLE _rc
        OUTPUT_VARIABLE _head ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
      if(_rc EQUAL 0 AND NOT _head STREQUAL "")
        set(_commit ${_head})
        execute_process(COMMAND ${_git} -C ${REPO} status --porcelain --untracked-files=no RESULT_VARIABLE _rc
          OUTPUT_VARIABLE _st ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(_rc EQUAL 0)
          if(_st STREQUAL "")
            set(_dirty 0)
          else()
            set(_dirty 1)
          endif()
        endif()
      endif()
    endif()
  endif()
  file(CONFIGURE OUTPUT ${OUT} @ONLY CONTENT
    "// generated by cmake/Generate.cmake at build time; do not edit
#pragma once
#define CMT_BUILD_COMMIT \"${_commit}\"
#define CMT_BUILD_DIRTY ${_dirty}  // 1 dirty, 0 clean, -1 unknown (no commit)
#define CMT_BUILD_VERSION \"${VERSION}\"
#define CMT_BUILD_TYPE \"${BUILD_TYPE}\"
#define CMT_BUILD_BACKEND \"${BACKEND}\"
#define CMT_BUILD_CXX_COMPILER \"${CXX_COMPILER}\"
#define CMT_BUILD_GPU_COMPILER \"${GPU_COMPILER}\"
#define CMT_BUILD_GPU_TOOLKIT \"${TOOLKIT}\"
")
  return()
endif()

function(cmt_build_info target backend toolkit gpu_compiler)
  set(_dir ${CMAKE_CURRENT_BINARY_DIR}/generated)
  set(_out ${_dir}/cmt_build_info.h)
  set(_repo ${CMT_ROOT})
  add_custom_target(${target}_build_info
    COMMAND ${CMAKE_COMMAND} -DCMT_SCRIPT=build_info -DREPO=${_repo} -DOUT=${_out} -DVERSION=${PROJECT_VERSION}
    -DBUILD_TYPE=${CMAKE_BUILD_TYPE} -DBACKEND=${backend}
    "-DCXX_COMPILER=${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}"
    "-DGPU_COMPILER=${gpu_compiler}" "-DTOOLKIT=${toolkit}" -P ${CMAKE_CURRENT_FUNCTION_LIST_FILE}
    BYPRODUCTS ${_out}
    COMMENT "cmt: build info (git commit) for ${target}"
    VERBATIM)
  add_dependencies(${target} ${target}_build_info)
  target_include_directories(${target} PRIVATE ${_dir})
endfunction()
