+    // Pin in batches of 512 pages, yielding the CPU between batches.
+    // pin_user_pages_fast() with FOLL_NOFAULT pins pages that are already
+    // mapped: it walks the page tables without mmap_lock first and may retry
+    // under mmap_lock, but never faults. Pages it leaves unpinned are pinned
+    // as upstream does, by NV_PIN_USER_PAGES() under mmap_read_lock. Letting
+    // pin_user_pages_fast() fault never-touched shared mappings itself (e.g.
+    // cudaHostAlloc memory) was measured slower on one host; the cause was
+    // not established.
+    for (pinned = 0; pinned < page_count; )
+    {
+        npages = NV_MIN(page_count - pinned, 512);
+        // FOLL_NOFAULT (Linux 5.16) is a macro until it became an enum
+        // constant; defined() also detects backports to older kernels.
+#if defined(FOLL_NOFAULT) || LINUX_VERSION_CODE >= KERNEL_VERSION(5, 16, 0)
+        ret = pin_user_pages_fast((unsigned long)address + pinned * PAGE_SIZE,
+                                  npages, gup_flags | FOLL_NOFAULT,
+                                  &user_pages[pinned]);
+        if (ret > 0)
