-     defined(NV_GET_USER_PAGES_HAS_ARGS_FLAGS_VMAS))
-#define NV_NUM_PIN_PAGES_PER_ITERATION 0x80000
+// Host-registration patch A pins with pin_user_pages_fast() and releases a
+// failed batch with NV_UNPIN_USER_PAGE(); patch B releases with
+// unpin_user_pages_dirty_lock(). Both are FOLL_PIN operations, so refuse to
+// build when nv-mm.h would fall back to get_user_pages()/put_page() (FOLL_GET).
+#if !defined(NV_PIN_USER_PAGES_PRESENT) || defined(NV_BSD)
+#error "host-registration patch A requires pin_user_pages() (NV_PIN_USER_PAGES_PRESENT)"
 #endif
 
