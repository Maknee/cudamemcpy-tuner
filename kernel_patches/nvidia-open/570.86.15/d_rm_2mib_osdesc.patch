+// D: true when the pages form aligned, contiguous 2 MiB runs in both the CPU and
+// the owning GPU's address space. Used only with RMAllowSysmemLargePages=1.
+static NvBool
+_osPageArrayIsHugeContig
+(
+    OBJGPU *pGpu,
+    MEMORY_DESCRIPTOR *pMemDesc
+)
+{
+    const NvU64 perHuge = RM_PAGE_SIZE_HUGE >> RM_PAGE_SHIFT;
+    RmPhysAddr *pCpu = memdescGetPteArray(pMemDesc, AT_CPU);
+    RmPhysAddr *pDma = memdescGetPteArrayForGpu(pMemDesc, pGpu, AT_GPU);
+    NvU64 i, head = 0;
+
+    if ((pMemDesc->pageArrayGranularity != RM_PAGE_SIZE) ||
+        (pMemDesc->PteAdjust != 0) ||
+        ((pMemDesc->PageCount % perHuge) != 0) ||
+        memdescGetContiguity(pMemDesc, AT_CPU))
+    {
+        return NV_FALSE;
+    }
+
+    for (i = 0; i < pMemDesc->PageCount; i++)
+    {
+        if ((i % perHuge) == 0)
+        {
+            head = i;
+            if (((pCpu[i] | pDma[i]) & (RM_PAGE_SIZE_HUGE - 1)) != 0)
+            {
+                return NV_FALSE;
+            }
+        }
+        else if ((pCpu[i] != pCpu[head] + ((i - head) << RM_PAGE_SHIFT)) ||
+                 (pDma[i] != pDma[head] + ((i - head) << RM_PAGE_SHIFT)))
+        {
+            return NV_FALSE;
+        }
+    }
+
+    return NV_TRUE;
+}
