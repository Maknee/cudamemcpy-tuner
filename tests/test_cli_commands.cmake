# Top-level command dispatch: help and usage errors never measure, and errors name their input.
# Bare `cmt` runs last: if it ever regresses into the benchmark, the earlier checks have already failed.
cmake_minimum_required(VERSION 3.18)
set(commands tune run export trace patch unpatch bench)
set(internal_enable "")

function(run_cmt)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env CUDA_VISIBLE_DEVICES= "CMT_INTERNAL_ENABLE=${internal_enable}" "${CMT}" ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(rc "${rc}" PARENT_SCOPE)
  set(out "${out}" PARENT_SCOPE)
  set(err "${err}" PARENT_SCOPE)
endfunction()

function(expect_usage label text)
  foreach(command IN LISTS commands)
    if(NOT text MATCHES "\n  ${command} ")
      message(FATAL_ERROR "${label}: usage does not list `${command}`:\n${text}")
    endif()
  endforeach()
endfunction()

foreach(form IN ITEMS --help -h help)
  run_cmt(${form})
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "cmt ${form}: expected exit 0, got ${rc}: ${err}")
  endif()
  expect_usage("cmt ${form}" "${out}")
endforeach()

foreach(command IN LISTS commands)
  run_cmt(${command} --help)
  set(expected "${out}")
  run_cmt(help ${command})
  if(NOT rc EQUAL 0 OR NOT out STREQUAL expected)
    message(FATAL_ERROR "cmt help ${command} differs from cmt ${command} --help")
  endif()
endforeach()

run_cmt(--version)
if(NOT rc EQUAL 0 OR NOT out MATCHES "^cmt [0-9]+\\.[0-9]+\\.[0-9]+ \\(commit ")
  message(FATAL_ERROR "cmt --version: expected `cmt X.Y.Z (commit ...)`, got ${rc}:\n${out}${err}")
endif()

# Each multi-word flag also takes its underscore spelling (and help shows the dashed one).
run_cmt(tune --out "${CMAKE_CURRENT_BINARY_DIR}/unused" --progress_bar=off --max_pinned_mib 64 --preview)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "cmt tune with underscore flags: expected exit 0, got ${rc}:\n${out}${err}")
endif()

run_cmt(bench --help)
if(NOT rc EQUAL 0 OR NOT out MATCHES "cmt bench" OR NOT out MATCHES "--path")
  message(FATAL_ERROR "cmt bench --help: expected the benchmark options, got ${rc}:\n${out}${err}")
endif()

run_cmt(bench --header)
if(NOT rc EQUAL 0 OR NOT out MATCHES "^[a-z_]+,")
  message(FATAL_ERROR "cmt bench --header: expected the CSV header, got ${rc}:\n${out}${err}")
endif()

run_cmt(--path pinned_ce)
if(NOT rc EQUAL 2 OR NOT err MATCHES "cmt bench")
  message(FATAL_ERROR "cmt --path: expected exit 2 pointing at `cmt bench`, got ${rc}:\n${out}${err}")
endif()

# Internal diagnostics are absent from public help and cannot execute without an explicit opt-in.
foreach(value IN ITEMS "" "0" "yes" "1")
  set(internal_enable "${value}")
  run_cmt(--help)
  foreach(command IN ITEMS check kernel)
    if(value STREQUAL "1")
      if(NOT out MATCHES "\n  ${command} ")
        message(FATAL_ERROR "enabled internal command missing from help: ${command}")
      endif()
    elseif(out MATCHES "\n  ${command} ")
      message(FATAL_ERROR "internal command exposed by default: ${command}")
    endif()
  endforeach()
  foreach(command IN ITEMS check kernel)
    foreach(form IN ITEMS direct help)
      if(form STREQUAL "help")
        run_cmt(help ${command})
      else()
        run_cmt(${command} --help)
      endif()
      if(value STREQUAL "1")
        if(NOT rc EQUAL 0 OR NOT out MATCHES "cmt ${command}")
          message(FATAL_ERROR "enabled ${command} help failed: ${out}${err}")
        endif()
      elseif(NOT rc EQUAL 2 OR NOT err MATCHES "CMT_INTERNAL_ENABLE=1")
        message(FATAL_ERROR "${command} bypassed the internal gate: ${out}${err}")
      endif()
    endforeach()
  endforeach()
endforeach()
set(internal_enable "")

set(missing "${CMAKE_CURRENT_BINARY_DIR}/no-such-dir/tune.json")
run_cmt(run --config "${missing}" -- true)
if(rc EQUAL 0 OR NOT err MATCHES "no-such-dir/tune\\.json")
  message(FATAL_ERROR "cmt run with a missing --config: expected an error naming it, got ${rc}:\n${err}")
endif()

# Without a visible GPU, `cmt tune` stops with exit 3 before it prints its plan or creates its output.
set(no_gpu_out "${CMAKE_CURRENT_BINARY_DIR}/no-gpu-tune")
file(REMOVE_RECURSE "${no_gpu_out}")
run_cmt(tune --search quick --out "${no_gpu_out}")
if(NOT rc EQUAL 3 OR NOT err MATCHES "no CUDA device visible" OR err MATCHES "Grid" OR EXISTS "${no_gpu_out}")
  message(FATAL_ERROR "cmt tune without a GPU: expected exit 3 before the plan, got ${rc}:\n${out}${err}")
endif()

# Preview/dry-run may describe a combined invocation, but must never create its
# output or execute the application's arguments (including its own --help).
set(launched "${CMAKE_CURRENT_BINARY_DIR}/unexpected-tune-launch")
file(REMOVE "${launched}")
foreach(mode IN ITEMS --preview --dry-run)
  run_cmt(tune --out "${no_gpu_out}" ${mode} -- "${CMAKE_COMMAND}" -E touch "${launched}")
  if(NOT rc EQUAL 0 OR EXISTS "${launched}" OR EXISTS "${no_gpu_out}" OR NOT err MATCHES "will not be launched" OR NOT out MATCHES "Grid")
    message(FATAL_ERROR "tune ${mode} launched/wrote output, or failed: ${rc}:\n${out}${err}")
  endif()
endforeach()
run_cmt(tune --out "${no_gpu_out}" -- "${CMAKE_COMMAND}" -E touch "${launched}")
if(NOT rc EQUAL 3 OR EXISTS "${launched}" OR EXISTS "${no_gpu_out}")
  message(FATAL_ERROR "failed tuning launched the application: ${rc}:\n${out}${err}")
endif()

run_cmt()
if(NOT rc EQUAL 2 OR NOT out STREQUAL "")
  message(FATAL_ERROR "bare cmt: expected exit 2 and nothing on stdout, got ${rc}:\n${out}${err}")
endif()
expect_usage("bare cmt" "${err}")
