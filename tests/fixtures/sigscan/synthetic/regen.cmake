# regen.cmake - assemble x86_64.S and aarch64.S (every variant V) into synthetic_code.inc, the byte arrays
# The Rust scanner tests feed these fixtures to the matchers.
#
#   cmake [-DAS=as] [-DOBJCOPY=objcopy] [-DLLVM_MC=llvm-mc] [-DLLVM_OBJCOPY=llvm-objcopy] -P regen.cmake
#
# Only needed after editing a .S file: the generated .inc is committed, so building and running the tests needs no
# assembler, and in particular no AArch64 one (most x86 hosts' llvm-mc lacks that target; LLVM 20 from apt.llvm.org
# has it). Intermediate objects go to <repo>/tmp/sigscan-synthetic.
cmake_minimum_required(VERSION 3.18)

get_filename_component(_here "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
get_filename_component(_repo "${_here}/../../../.." ABSOLUTE)
set(_work "${_repo}/tmp/sigscan-synthetic")
file(MAKE_DIRECTORY "${_work}")
foreach(tool AS OBJCOPY LLVM_MC LLVM_OBJCOPY)
  if(NOT DEFINED ${tool})
    string(TOLOWER "${tool}" _t)
    string(REPLACE "_" "-" _t "${_t}")
    set(${tool} "${_t}")
  endif()
endforeach()

set(_variants 0 1 2 3 4 5 6 7)
set(_out "// generated by tests/fixtures/sigscan/synthetic/regen.cmake from x86_64.S and aarch64.S - do not edit\n")
string(APPEND _out "// kSynthetic[arch][variant]: arch 0 = x86_64, 1 = aarch64; 0xf00 bytes each, loaded at kSyntheticBase.\n")
string(APPEND _out "static const unsigned char kSynthetic[2][8][0xf00] = {\n")
foreach(arch x86_64 aarch64)
  string(APPEND _out " { // ${arch}\n")
  foreach(v IN LISTS _variants)
    set(_o "${_work}/${arch}-${v}.o")
    set(_b "${_work}/${arch}-${v}.bin")
    if(arch STREQUAL "x86_64")
      execute_process(COMMAND ${AS} --64 --defsym V=${v} -o ${_o} ${_here}/x86_64.S RESULT_VARIABLE rc)
      set(_objcopy ${OBJCOPY})
    else()
      execute_process(COMMAND ${LLVM_MC} -triple=aarch64 -filetype=obj -defsym=V=${v} -o ${_o} ${_here}/aarch64.S
                      RESULT_VARIABLE rc)
      set(_objcopy ${LLVM_OBJCOPY})
    endif()
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "assembling ${arch} V=${v} failed")
    endif()
    execute_process(COMMAND ${_objcopy} -O binary -j .text ${_o} ${_b} RESULT_VARIABLE rc)
    file(SIZE "${_b}" _size)
    if(NOT rc EQUAL 0 OR NOT _size EQUAL 3840)
      message(FATAL_ERROR "${arch} V=${v}: objcopy failed or the code is not 0xf00 bytes (${_size})")
    endif()
    file(READ "${_b}" _hex HEX)
    string(APPEND _out "  { // V=${v}\n")
    foreach(_at RANGE 0 7679 48) # 24 bytes per line (CMake regexes have no {n} repetition)
      string(SUBSTRING "${_hex}" ${_at} 48 _line)
      string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _line "${_line}")
      string(APPEND _out "  ${_line}\n")
    endforeach()
    string(APPEND _out "  },\n")
  endforeach()
  string(APPEND _out " },\n")
endforeach()
string(APPEND _out "};\n")
file(WRITE "${_here}/synthetic_code.inc" "${_out}")
message(STATUS "wrote ${_here}/synthetic_code.inc")
